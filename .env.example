# ==============================================================================
# Incursion Track 3: Team Recruitment Automation Tool - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local development.

# --- Database Configuration (PostgreSQL) ---
POSTGRES_DB=recruitment_db
POSTGRES_USER=recruitment_user
POSTGRES_PASSWORD=recruitment_pass
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Full SQLAlchemy / asyncpg connection URL
DATABASE_URL=postgresql://recruitment_user:recruitment_pass@localhost:5432/recruitment_db

# --- API Server Settings ---
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- External Integration Keys (Day 5-10, M2 & M4) ---
# Optional for Day 1; needed for GitHub rate-limit bypass and optional Gemini resume extraction
GITHUB_TOKEN=your_github_token_here
GEMINI_API_KEY=your_gemini_api_key_here
